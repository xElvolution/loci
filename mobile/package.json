    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~58.0.25",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
