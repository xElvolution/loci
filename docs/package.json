{
  "name": "loci-docs",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "loci documentation site. Standalone Next.js app that renders the Markdown in content/",
  "scripts": {
    "dev": "next dev -p 3771",
    "build": "next build",
    "start": "next start -p 3770",
