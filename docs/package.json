    "test:e2e": "playwright test"
  },
  "engines": { "node": ">=20.9" },
  "dependencies": {
    "marked": "^16.0.0",
    "motion": "^14.8.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
